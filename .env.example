# ============================================
# SECUREVAULT NEXT-GEN - CONFIGURATION
# ============================================
# Copier ce fichier vers .env et personnaliser

# ============================================
# 1. MACHINE LEARNING
# ============================================

# Durée de rétention des logs actifs (en jours)
# Les logs de cette période servent à entraîner le modèle ML
ML_TRAINING_RETENTION_DAYS=30

# Fréquence de ré-entraînement du modèle (en heures)
ML_RETRAINING_INTERVAL_HOURS=24

# Nombre minimum de logs requis pour entraîner le modèle
ML_MIN_LOGS_FOR_TRAINING=100

# Seuil de contamination pour Isolation Forest (0.01 = 1%)
ML_CONTAMINATION_THRESHOLD=0.05

# Nombre d'arbres dans la forêt d'isolation
ML_N_ESTIMATORS=100

# ============================================
# 2. COMPRESSION DES LOGS
# ============================================

# Durée avant compression des logs anciens (en jours)
LOG_COMPRESSION_AFTER_DAYS=90

# Format de compression (gzip, zstd, brotli)
LOG_COMPRESSION_FORMAT=gzip

# Niveau de compression (1-9, 9 = max)
LOG_COMPRESSION_LEVEL=9

# Supprimer les logs après compression
LOG_DELETE_AFTER_COMPRESSION=false

# ============================================
# 3. AUTHENTIFICATION 2FA
# ============================================

# Méthode 2FA par défaut (totp, email, both)
# totp = Google Authenticator
# email = Code unique par email
# both = L'utilisateur choisit
AUTH_2FA_METHOD=both

# Durée de validité du code email (en secondes)
AUTH_EMAIL_CODE_VALIDITY=300

# Nombre de tentatives 2FA avant blocage
AUTH_2FA_MAX_ATTEMPTS=5

# Durée de blocage après échec 2FA (en minutes)
AUTH_2FA_LOCKOUT_MINUTES=15

# ============================================
# 4. EMAIL / SMTP
# ============================================

# Activer l'envoi d'emails
EMAIL_ENABLED=true

# Vérifier la connexion Internet avant envoi
EMAIL_CHECK_INTERNET=true

# Serveur SMTP
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=true

# Identifiants SMTP
EMAIL_SMTP_USERNAME=votre-email@gmail.com
EMAIL_SMTP_PASSWORD=votre-mot-de-passe-app

# Expéditeur
EMAIL_FROM_ADDRESS=noreply@securevault.com
EMAIL_FROM_NAME=SecureVault Security

# Timeout de connexion (secondes)
EMAIL_TIMEOUT_SECONDS=10

# Nombre de tentatives en cas d'échec
EMAIL_RETRY_ATTEMPTS=3

# ============================================
# 5. RÉACTIONS AUX MENACES
# ============================================

# Seuils de risque (0-100)
THREAT_LOW_THRESHOLD=0
THREAT_MEDIUM_THRESHOLD=40
THREAT_HIGH_THRESHOLD=60
THREAT_CRITICAL_THRESHOLD=80

# Durée de blocage critique (minutes)
THREAT_CRITICAL_BLOCK_MINUTES=30

# Rate limiting MEDIUM (actions par seconde)
THREAT_MEDIUM_RATE_LIMIT=0.2

# Rate limiting HIGH (actions par seconde)
THREAT_HIGH_RATE_LIMIT=0.1

# ============================================
# 6. NOTIFICATIONS
# ============================================

# Types de notifications activés (séparés par virgule)
# file_shared, file_accessed, security_alert, account_locked
NOTIFICATION_ENABLED_TYPES=file_shared,file_accessed,security_alert,account_locked

# Envoyer notifications par email
NOTIFICATION_SEND_EMAIL=true

# Envoyer notifications in-app
NOTIFICATION_SEND_INAPP=true

# ============================================
# 7. BASE DE DONNÉES
# ============================================

# Chemin de la base de données SQLite
DATABASE_PATH=./database/secure_vault.db

# Activer le mode WAL (Write-Ahead Logging)
DATABASE_WAL_MODE=true

# Taille du cache (en Ko)
DATABASE_CACHE_SIZE=10000

# ============================================
# 8. SÉCURITÉ
# ============================================

# Durée de validité des tokens de session (heures)
SESSION_TOKEN_VALIDITY_HOURS=24

# Durée de validité des partages (jours, 0 = illimité)
SHARE_DEFAULT_EXPIRY_DAYS=7

# Nombre maximum de fichiers partagés simultanément
SHARE_MAX_FILES_PER_USER=100

# ============================================
# 9. PERFORMANCE
# ============================================

# Taille maximale de fichier (Mo)
MAX_FILE_SIZE_MB=100

# Nombre de workers pour l'analyse ML
ML_WORKER_THREADS=4

# Intervalle d'auto-sauvegarde des profils ML (secondes)
ML_AUTOSAVE_INTERVAL_SECONDS=300

# ============================================
# 10. LOGS & MONITORING
# ============================================

# Niveau de logs (debug, info, warning, error)
LOG_LEVEL=info

# Rotation des logs (daily, weekly, monthly)
LOG_ROTATION=daily

# Taille maximale avant rotation (Mo)
LOG_MAX_SIZE_MB=50

# Nombre de fichiers de logs à conserver
LOG_RETENTION_COUNT=10
