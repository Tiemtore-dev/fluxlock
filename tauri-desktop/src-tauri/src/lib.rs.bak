// État global de l'application
struct AppState {
    db: Arc<Mutex<Option<Database>>>,
    current_user_id: Arc<Mutex<Option<i64>>>,
    session_token: Arc<Mutex<Option<String>>>,
    session: Arc<Mutex<Option<String>>>, // Alias for session_token used by transfer module
    last_activity: Arc<Mutex<std::time::Instant>>,
    auto_lock_minutes: Arc<Mutex<u64>>,
    threat_reactor: Arc<ThreatReactor>,
    transfer_manager: Arc<Mutex<Option<transfer::commands::TransferManager>>>,
    /// Fichiers déchiffrés temporaires à nettoyer (M01 — audit sécurité)
    /// Clé: chemin absolu, Valeur: timestamp de création
    decrypted_temp_files: Arc<Mutex<Vec<String>>>,
    /// Répertoire de données résolu au démarrage (Android: app_data_dir; Desktop: hidden_storage)
    data_dir: Arc<Mutex<Option<std::path::PathBuf>>>,
    /// Gestionnaire de logs signés (hash chain SHA3-256 + ML-DSA-65)
    signed_log_manager: Arc<Mutex<Option<signed_log::SignedLogManager>>>,
    /// Activation des logs signés (persisté dans config)
    logging_enabled: Arc<Mutex<bool>>,
    /// Mode isolation réseau — bloque toute activité réseau
    isolation_mode: Arc<Mutex<bool>>,
}

