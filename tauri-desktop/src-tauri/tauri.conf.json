{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Gestionnaire de mots de passe sécurisé",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "productName": "FluXlock",
  "mainBinaryName": "FluXlock",
  "version": "2.2.4",
  "identifier": "com.fluxlock.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QjMxNTA4RUI5MEVGNzgKUldSNDc1RHJDQld6bGJsOTB5Y0ZjbTVvc3MwN29DVmZvamgxUm4zT2k1eEZjaTNGM3VXcTlhb1MK",
      "endpoints": [
        "https://github.com/Tiemtore-dev/fluxlock-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://tauri.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "FluXlock",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ]
  }
}